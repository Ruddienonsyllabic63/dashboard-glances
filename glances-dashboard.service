[Unit]
Description=Glances Dashboard
After=network.target glances-web.service
Requires=glances-web.service

[Service]
Type=simple
WorkingDirectory=/var/www/dashboard_glances
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8099 --reload
Restart=always
RestartSec=5
Environment=GLANCES_DASH_SECRET=glances-dashboard-secret-change-me

[Install]
WantedBy=multi-user.target
